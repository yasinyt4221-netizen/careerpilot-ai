# Optional. Set this in your shell before launching Uvicorn (no dotenv loader required).
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Download public model files once: python prepare_semantic_model.py
# Document text is embedded locally; request handling never downloads models.
SEMANTIC_ENABLED=true
# Optional Gemini API: connect a key using http://localhost:3000/connections.
# Keys entered there stay in process memory, not in this file or the browser.
# The model can be overridden in the backend process environment:
GEMINI_MODEL=gemini-3.5-flash-lite
# Private friend showcase hosting only; see docs/deployment.md.
HOSTED_MODE=false
# Set APP_ACCESS_CODE (16+ characters) and GEMINI_API_KEY in private host settings.
# Never put either value in NEXT_PUBLIC_ settings or source control.
# Optional absolute path; default backend/.models (ignored).
# CAREERPILOT_MODEL_CACHE=C:/models/careerpilot
